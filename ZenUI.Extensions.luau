local oldCreateWindow=Library.CreateWindow
Library.CreateWindow=function(self,o)o=type(o)=="table" and table.clone(o)or{};local w=oldCreateWindow(self,o);if type(w)=="table" and type(w.CreateTab)=="function"then local old=w.CreateTab;w.CreateTab=function(win,opts)return enhanceTab(old(win,opts))end end;return w end

